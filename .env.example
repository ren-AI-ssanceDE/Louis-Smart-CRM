# ============================================================================
# Louis Smart CRM — Umgebungsvariablen (NUR Infrastruktur, optional)
# ----------------------------------------------------------------------------
# Diese Datei ist für den Betrieb NICHT erforderlich — der Stack startet auch
# ohne sie. Sämtliche USER-Einstellungen (KI-Provider & API-Key, Telegram,
# MCP-Server, Limits, Workflows, Governance) werden AUSSCHLIESSLICH über das
# ADMIN-PANEL konfiguriert und in der Datenbank gespeichert — niemals in
# Dateien. Die Variablen hier betreffen nur Container-Infrastruktur
# (DB-Verbindung, Auth-Secret, App-URL) für fortgeschrittene Selbst-Hoster.
# ============================================================================

# --- Authentifizierung (optional; ohne Angabe generiert die App das Secret beim ersten Start) ---
# Mindestens 32 Zeichen langes, zufälliges Secret (z. B. `openssl rand -base64 48`)
# Das Secret wird standardmäßig in der Datenbank gespeichert (sys_app_security)
# und beim ersten Start automatisch generiert — diese Variable ist nur ein
# optionaler Override für fortgeschrittene Selbst-Hoster.
AUTH_SECRET=some_random_secret_at_least_32_chars_long_for_security

# --- App-URLs ---
# Öffentlich erreichbare URL der App (für OAuth-Callbacks und Links)
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- KI-Anbindung (optional) ---
# Der KI-Provider (OpenAI/DeepSeek/Anthropic/Gemini/lokal) wird PRIMÄR über
# das Admin-Panel konfiguriert (Admin → KI-Einstellungen). GEMINI_API_KEY ist
# nur ein Fallback für Gemini, falls in der Admin-UI kein Key hinterlegt ist.
GEMINI_API_KEY=

# --- Datenbank (Defaults passen zum Compose-DB-Container) ---
DATABASE_URL=postgres://user:password@localhost:5432/louis_crm
PGHOST=db
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=louis_crm

# --- Telegram (optional) ---
# Der Telegram-Bot wird NICHT hier, sondern in der Admin-Oberfläche
# konfiguriert (Admin → Telegram). Der Gate-Container wartet selbstständig
# auf die Konfiguration — kein Token in dieser Datei nötig.
