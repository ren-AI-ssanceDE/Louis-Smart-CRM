{
  "name": "louis-smart-crm",
  "private": true,
  "version": "2.1.13",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "setup:volumes": "node scripts/setup-postgres-volume.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env E2E_PORT=3000 playwright test",
    "test:e2e:ephemeral": "cross-env E2E_STACK=ephemeral playwright test",
    "test:stack:up": "docker compose -f docker-compose.test.yml up -d --build",
    "test:stack:down": "docker compose -f docker-compose.test.yml down -v",
    "test:stack:seed": "node scripts/qa-seed-all.mjs",
    "test:full": "node scripts/test-full.mjs",
    "test:zugferd": "tsx scripts/e2e-validate.ts",
    "dev:e2e": "cross-env PORT=3100 tsx server.ts",
    "setup-assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "check:rules": "node scripts/check-project-rules.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/express": "^0.12.2",
